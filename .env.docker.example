# ============================================================
# Terrabox Docker Mode Configuration
# Usage: cp .env.docker.example .env  then modify the paths
# ============================================================

# Main switch: Set to true to start all AI services via Docker containers
TERRABOX_USE_DOCKER=true

# ── vLLM (Qwen3VL 8B) ───────────────────────────────────────
# Model directory on the host machine (mounted as /model inside the container)
VLM_MODEL_PATH=/data1/yuhongjie2/sft/qwen3vl_8b_4bit_finetune/merged_model/
# model field in vLLM API requests (path inside the container)
VLM_MODEL_NAME=/model
# GPU IDs on the host machine (separated by commas for multiple GPUs, mapped to cuda:0, cuda:1... inside the container)
VLM_GPU_DEVICES=2,3
VLM_TENSOR_PARALLEL_SIZE=2

# ── SAM2 ────────────────────────────────────────────────────
SAM2_GPU_DEVICES=0
# Checkpoint directory on the host machine (mounted as /checkpoints inside the container)
SAM2_CHECKPOINT_HOST=/data1/yuhongjie2/sam2/checkpoints
# sam2 configs directory on the host machine (mounted as /sam2_configs inside the container)
SAM2_CONFIG_HOST=/data1/yuhongjie2/sam2/sam2/configs

# ── RemoteCLIP ──────────────────────────────────────────────
REMOTECLIP_GPU_DEVICES=3
# Checkpoint directory on the host machine (mounted as /checkpoints inside the container)
REMOTECLIP_CKPT_HOST=/data1/yuhongjie2/RemoteCLIP/checkpoints

# ── RemoteSAM ───────────────────────────────────────────────
REMOTESAM_GPU_DEVICES=3
# Pretrained weights directory on the host machine (mounted as /checkpoints inside the container)
REMOTESAM_CHECKPOINT_HOST=/data1/yuhongjie2/RemoteSAM/pretrained_weights

# ── Strip-RCNN ──────────────────────────────────────────────
STRIP_RCNN_GPU_DEVICES=0
# CKPT directory on the host machine (mounted as /ckpt inside the container)
STRIP_RCNN_CKPT_HOST=/data1/yuhongjie2/Strip-RCNN/ckpt
# Configs directory on the host machine (mounted as /configs inside the container)
STRIP_RCNN_CONFIG_HOST=/data1/yuhongjie2/Strip-RCNN/configs

# ── InstructSAM ─────────────────────────────────────────────
INSTRUCTSAM_GPU_DEVICES=1
# Model directory on the host machine (mounted as /models inside the container)
# Must contain: sam2_hiera_large.pt, GeoRSCLIP-ViT-L-14.pt
INSTRUCTSAM_MODELS_HOST=/data1/yuhongjie2/terra_model/instructsam

# ── Image Data Directory ─────────────────────────────────────
# SAM2/RemoteCLIP/Strip-RCNN/RemoteSAM accept local image paths
# This directory is mounted with the same path in all containers to ensure path consistency
DATA_MOUNT_HOST=/data1
