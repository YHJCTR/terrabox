# Terrabox Platform Environment Configuration
# scripts/init_test_oauth_providers.py

# Database Configuration
TL_DB_URL=sqlite:///./terrabox_platform.db

# JWT Configuration
TL_JWT_SECRET=dev_jwt_change_me_in_production

# API Key Configuration
TL_APIKEY_KDF_SECRET=secure_apikey_kdf_1759871452_5iCyiF9Y2y86vPGKfZzm4B5jHOpCBbsERWqc640t1Qk

# Environment
TL_ENV=dev

GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Global Paths ──────────────────────────────────────────────
# Default to relative paths; override with absolute paths if needed
TERRABOX_UPLOAD_DIR=./terrabox_uploads
AGENT_LOG_PATH=./agent.log

# ============================================================
# Non-Docker Mode Service Configuration (TERRABOX_USE_DOCKER=false)
# The paths below are the developer's environment as examples.
# Open-source users: replace all paths with your own.
# ============================================================

TERRABOX_USE_DOCKER=false

# ── vLLM (Vision Language Model, port 9000) ─────────────────
# Python interpreter path in the conda env where vllm is installed
VLLM_PYTHON_EXEC=/home/yuhongjie/miniconda3/envs/unsloth/bin/python
# Model weights directory (Qwen-VL or compatible)
VLM_MODEL_PATH=/data1/yuhongjie2/sft/qwen3vl_8b_4bit_finetune/merged_model/
VLM_GPU_DEVICES=2,3
VLM_TENSOR_PARALLEL_SIZE=2
# VLM_PORT=9000  # Uncomment to change port

# ── SAM2 (port 9002) ────────────────────────────────────────
SAM2_PYTHON_EXEC=/home/yuhongjie/miniconda3/envs/sam2/bin/python
SAM2_SERVER_SCRIPT=/data1/yuhongjie2/sam2/sam2_server2.py
SAM2_WORK_DIR=/data1/yuhongjie2/sam2
SAM2_GPU_DEVICES=0
# SAM2_PORT=9002

# ── RemoteCLIP (port 9003) ──────────────────────────────────
REMOTECLIP_PYTHON_EXEC=/home/yuhongjie/miniconda3/envs/RemoteCLIP/bin/python
REMOTECLIP_SERVER_SCRIPT=/data1/yuhongjie2/RemoteCLIP/start2.py
REMOTECLIP_WORK_DIR=/data1/yuhongjie2/RemoteCLIP
REMOTECLIP_GPU_DEVICES=3
# REMOTECLIP_PORT=9003

# ── RemoteSAM (port 9004) ───────────────────────────────────
REMOTESAM_PYTHON_EXEC=/home/yuhongjie/miniconda3/envs/RemoteSAM/bin/python
REMOTESAM_SERVER_SCRIPT=/data1/yuhongjie2/RemoteSAM/start.py
REMOTESAM_WORK_DIR=/data1/yuhongjie2/RemoteSAM
REMOTESAM_GPU_DEVICES=3
# REMOTESAM_PORT=9004

# ── Strip-RCNN (port 9005) ──────────────────────────────────
STRIP_RCNN_PYTHON_EXEC=/home/yuhongjie/miniconda3/envs/strip/bin/python
STRIP_RCNN_SERVER_SCRIPT=/data1/yuhongjie2/Strip-RCNN/start.py
STRIP_RCNN_WORK_DIR=/data1/yuhongjie2/Strip-RCNN
STRIP_RCNN_GPU_DEVICES=0
STRIP_RCNN_CONFIG_PATH=/data1/yuhongjie2/Strip-RCNN/configs/strip_rcnn/orig/strip_rcnn_s_fpn_1x_dota_le90.py
STRIP_RCNN_CHECKPOINT_PATH=/data1/yuhongjie2/Strip-RCNN/ckpt/stripnet_s.pth
# STRIP_RCNN_PORT=9005

# ── Agent LLM (port 9100) — primary config is agent_config.yaml
# Environment variables here act as fallback overrides
AGENT_LLM_PYTHON_EXEC=/home/yuhongjie/miniconda3/envs/unsloth/bin/python
AGENT_LLM_MODEL_PATH=/data1/yuhongjie2/Earth-Agent/llm/qwen/3_8B/
