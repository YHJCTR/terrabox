      "id": "flood_detection_01__fail_drop_step2",
      "task_type": "flood_detection",
      "disaster_category": "flood",
      "difficulty": "easy",
      "prompt": "我有一张洪灾发生后的多光谱卫星影像，请提取淹没水体区域，计算淹没总面积（km²），并标注淹没范围。",
      "tool_calls": [
        {
          "step": 1,
          "tool": "geo_raster.calculate_index",
          "args": {
            "band_a_path": "green.tif",
            "band_b_path": "nir.tif",
            "index_name": "NDWI",
            "output_path": "ndwi.tif"
          },
          "sample_output": {
            "status": "success",
            "output_path": "ndwi.tif"
          },
          "note": "NDWI = (Green-NIR)/(Green+NIR)，水体NDWI>0"
        },
        {
          "step": 2,
          "tool": "geo_statistics.count_pixels_condition",
          "args": {
            "input_path": "flood_mask.tif",
            "lower": 254
          },
          "sample_output": {
            "count": 45820,
            "total": 1000000,
            "ratio": 0.04582
          },
          "note": "lower=254 等效于 ==255，容忍浮点舍入"
        },
        {
          "step": 3,
          "tool": "geo_basic.pixel_area",
          "args": {
            "pixels": "$step3.count",
            "gsd_m": 10
          },
          "sample_output": {
            "area_m2": 4582000.0,
            "area_km2": 4.582,
            "pixel_area_m2": 100.0
          }
        },
        {
          "step": 4,
          "tool": "geo_perception.vlm_analyze",
          "args": {
            "image_paths": [
              "rgb.tif"
            ],
            "prompt": "请识别并标注图中被洪水淹没的区域，描述积水范围和严重程度"
          },
          "sample_output": {
            "analysis": "图中大面积蓝色区域为积水...",
            "bboxes": [
              {
                "x1": 120,
                "y1": 80,
                "x2": 340,
                "y2": 210
              }
            ]
          }
        },
        {
          "step": 5,
          "tool": "geo_perception.draw_bboxes",
          "args": {
            "image_path": "rgb.tif",
            "bboxes": "$step5.bboxes",
            "output_path": "flood_annotated.png"
          },
          "sample_output": {
            "output_path": "flood_annotated.png"
          }
        }
      ],
