  "contract": {
    "gap": "Existing self-evolving agent methods do not by themselves establish safe, auditable transfer for multi-tool product dependencies or static prompt updates.",
    "task": "Develop two separate, evidence-bounded methods and evaluation protocols for ExperienceEvo product-state guidance and PromptEvo static behavior-protocol evolution.",
    "outcomes": ["frozen task-level rollout metrics", "paired uncertainty estimates", "mechanism/provenance audits", "candidate-ledger audits"],
    "questions": [
      {"id": "E1", "text": "Under fixed manifests, do learned product-state transition families improve grounded geospatial tool execution beyond generic guards and deterministic fallbacks?", "lock": "SEMANTIC"},
      {"id": "P1", "text": "Under frozen development and locked-test splits, can diff-grounded static protocol patches improve a declared primary metric without violating protected metrics?", "lock": "SEMANTIC"}
    ],
    "contribution": "Two independent, auditable agent self-evolution method papers with implementation-aligned mechanisms, visual overviews, evidence templates, and explicitly bounded claims.",
    "nonclaims": [
      "No final performance, SOTA, causal, safety, or cross-environment generalization claim is supported before release evidence exists.",
      "ExperienceEvo deterministic v3 fallbacks are not train-rollout experience.",
      "PromptEvo compiler validity or CLI persistence is not empirical candidate acceptance.",
      "Historical diagnostic results are not substitutes for frozen main-table evidence."
    ]
  },
